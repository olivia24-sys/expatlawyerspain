# Cloudflare Pages security headers — applied to every route.
# X-Content-Type-Options and Referrer-Policy were already set at the edge; repeated here so the
# policy is explicit and version-controlled. HSTS + X-Frame-Options + Permissions-Policy are new.
# The CSP is Report-Only for now (browsers report violations but do NOT block), so it cannot break
# GA4 / Turnstile / Ahrefs / Formspree / inline handlers. Review reports, then switch the header
# name to "Content-Security-Policy" to enforce.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://analytics.ahrefs.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://static.cloudflareinsights.com https://cloudflareinsights.com https://analytics.ahrefs.com; frame-src https://challenges.cloudflare.com; form-action https://formspree.io; base-uri 'self'; object-src 'none'

# WIDGET FRAMEWORK (see tools/WIDGET-FRAMEWORK-NOTES.md). These blocks MUST
# come AFTER the /* block: rules apply top to bottom, and the "!" detach only
# removes a header attached by an EARLIER rule.
#
# /widgets/* is the ONLY embeddable path on the site. It detaches the global
# X-Frame-Options: DENY (so partner sites can iframe it; frame-ancestors *
# makes that explicit) and carries its own STRICT ENFORCED CSP: same-origin
# only, no inline script/style, so a widget frame cannot load or run anything
# third-party. The global report-only CSP is detached to keep violation
# reports clean. NOTE for the CSP-enforce flip: when /* switches to an
# enforced Content-Security-Policy, add "! Content-Security-Policy" above the
# Content-Security-Policy line here, or /widgets/* will be governed by the
# intersection of both policies.
/widgets/*
  ! X-Frame-Options
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors *; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex
  # The widget JS/CSS/HTML are unversioned and were being served stale after a
  # deploy (a long edge/browser cache kept the old file even though the new one
  # shipped). Always-revalidate makes the origin authoritative: cacheable, but
  # revalidated before reuse, so a deploy is picked up on the next request while
  # unchanged assets still return cheap 304s. Fonts live at /fonts/, not here, so
  # their long cache is untouched. On deploy, also purge the widget URLs (see
  # tools/WIDGET-FRAMEWORK-NOTES.md deploy runbook) to flush copies cached before
  # this rule existed.
  Cache-Control: public, max-age=0, must-revalidate

# /embed/* is the loader partners <script src> from their own pages. Edge
# cached, but short enough that a loader fix rolls out within the hour.
/embed/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
